generator client {
  provider        = "prisma-client-js"
  output          = "../lib/generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Note: Uses Neon PgBouncer pooler (-pooler suffix) for serverless compatibility
  // For migrations, uncomment DIRECT_URL in .env and add: directUrl = env("DIRECT_URL")
}

model artists {
  vocadb_id    Int            @id
  name         String
  artist_type  String
  thumb_url    String?
  song_artists song_artists[]

  @@index([artist_type])
  @@index([name])
}

model crawler_progress {
  id              String    @id
  crawler_type    String
  status          String
  started_at      DateTime
  completed_at    DateTime?
  last_offset     Int       @default(0)
  total_processed Int       @default(0)
  total_target    Int?
  error_message   String?
  metadata        Json?

  @@index([crawler_type, status])
}

model daily_view_counts {
  pv_id         Int
  recorded_date DateTime @db.Date
  total_views   BigInt
  pvs           pvs      @relation(fields: [pv_id], references: [id], onDelete: Cascade)

  @@id([pv_id, recorded_date])
  @@index([pv_id, recorded_date(sort: Desc)])
  @@index([recorded_date(sort: Desc)])
  @@index([recorded_date(sort: Desc), pv_id], map: "idx_daily_recent_changes")
}

model lyrics {
  id               Int     @id @default(autoincrement())
  song_id          Int
  translation_type String
  culture_code     String?
  source           String?
  url              String?
  value            String?
  songs            songs   @relation(fields: [song_id], references: [vocadb_id], onDelete: Cascade)

  @@index([culture_code])
  @@index([song_id])
}

model pvs {
  id                    Int                 @id @default(autoincrement())
  song_id               Int
  pv_id                 String
  service               String
  pv_type               String
  name                  String?
  url                   String
  thumb_url             String?
  disabled              Boolean             @default(false)
  view_count            BigInt?
  view_count_updated_at DateTime?
  daily_view_counts     daily_view_counts[]
  songs                 songs               @relation(fields: [song_id], references: [vocadb_id], onDelete: Cascade)

  @@unique([song_id, service, pv_id])
  @@index([service, song_id, view_count(sort: Desc)], map: "idx_pvs_youtube_views")
  @@index([pv_id])
  @@index([service])
  @@index([service, view_count(sort: Desc)])
  @@index([song_id, service])
  @@index([view_count(sort: Desc)])
}

model song_artists {
  id         Int     @id @default(autoincrement())
  song_id    Int
  artist_id  Int
  categories String
  roles      String?
  is_support Boolean @default(false)
  name       String?
  artists    artists @relation(fields: [artist_id], references: [vocadb_id], onDelete: Cascade)
  songs      songs   @relation(fields: [song_id], references: [vocadb_id], onDelete: Cascade)

  @@unique([song_id, artist_id])
  @@index([artist_id])
  @@index([categories])
  @@index([song_id, is_support])
}

model song_names {
  id       Int    @id @default(autoincrement())
  song_id  Int
  language String
  value    String
  songs    songs  @relation(fields: [song_id], references: [vocadb_id], onDelete: Cascade)

  @@unique([song_id, language])
  @@index([song_id, language], map: "idx_song_names_titles")
  @@index([language])
  @@index([value])
}

model song_tags {
  id      Int   @id @default(autoincrement())
  song_id Int
  tag_id  Int
  count   Int   @default(0)
  songs   songs @relation(fields: [song_id], references: [vocadb_id], onDelete: Cascade)
  tags    tags  @relation(fields: [tag_id], references: [vocadb_id], onDelete: Cascade)

  @@unique([song_id, tag_id])
  @@index([tag_id, song_id], map: "idx_song_tags_exclusion")
  @@index([tag_id])
}

model songs {
  vocadb_id       Int                  @id
  default_name    String
  song_type       String?
  publish_date    DateTime?            @db.Date
  create_date     DateTime?
  length_seconds  Int?
  favorited_times Int                  @default(0)
  rating_score    Int                  @default(0)
  thumb_url       String?
  thumb_url_small String?
  crawled_at      DateTime
  lyrics          lyrics[]
  pvs             pvs[]
  song_artists    song_artists[]
  song_names      song_names[]
  song_tags       song_tags[]
  favoritedBy     UserFavoriteSong[]
  playlistSongs   UserPlaylistSong[]

  @@index([favorited_times(sort: Desc)], map: "idx_songs_favorited")
  @@index([publish_date(sort: Desc)], map: "idx_songs_publish")
  @@index([rating_score(sort: Desc)], map: "idx_songs_rating")
}

model tags {
  vocadb_id     Int         @id
  name          String      @unique
  category_name String?
  song_tags     song_tags[]

  @@index([category_name])
}

model ranking_cache {
  id                    Int      @id @default(autoincrement())
  ranking_type          String   // 'total', 'weekly', 'new'
  rank                  Int
  song_id               Int
  default_name          String
  title_korean          String?
  title_english         String?
  title_japanese        String?
  title_romaji          String?
  artist_string         String?
  youtube_id            String?
  youtube_url           String?
  thumb_url             String?
  view_count            BigInt?
  view_count_updated_at DateTime?
  publish_date          DateTime? @db.Date
  song_type             String?
  favorited_times       Int?
  rating_score          Int?
  length_seconds        Int?
  weekly_increase       BigInt?
  daily_increase        BigInt?
  updated_at            DateTime  @default(now())

  @@unique([ranking_type, rank])
  @@index([ranking_type, rank])
  @@index([updated_at])
}

model song_weekly_stats {
  song_id         Int      @id
  weekly_increase BigInt
  current_views   BigInt
  previous_views  BigInt
  updated_at      DateTime @default(now())

  @@index([weekly_increase(sort: Desc)])
  @@index([updated_at])
}

// ============================================
// Authentication & User Management Models
// ============================================

// User accounts (NextAuth.js)
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  favorites UserFavoriteSong[]
  playlists UserPlaylist[]

  @@map("users")
}

// OAuth account linking (NextAuth.js)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// Session management (NextAuth.js)
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Email verification tokens (NextAuth.js)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// User favorite songs
model UserFavoriteSong {
  id        String   @id @default(cuid())
  userId    String
  songId    Int
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  song songs @relation(fields: [songId], references: [vocadb_id], onDelete: Cascade)

  @@unique([userId, songId])
  @@index([userId])
  @@index([songId])
  @@map("user_favorite_songs")
}

// User playlists
model UserPlaylist {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  songs UserPlaylistSong[]

  @@index([userId])
  @@map("user_playlists")
}

// Playlist songs (junction table)
model UserPlaylistSong {
  id         String   @id @default(cuid())
  playlistId String
  songId     Int
  order      Int
  addedAt    DateTime @default(now())

  playlist UserPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song     songs        @relation(fields: [songId], references: [vocadb_id], onDelete: Cascade)

  @@unique([playlistId, songId])
  @@index([playlistId])
  @@index([songId])
  @@map("user_playlist_songs")
}
