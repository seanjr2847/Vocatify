# YouTube Data API v3
# Get your API key from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-api-key-here

# PostgreSQL Database
# For Vercel deployment, use Neon (recommended): https://console.neon.tech/signup
# Connection string format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
#
# IMPORTANT: Add connection_limit=5 for GitHub Actions parallel crawlers
# - 10 parallel jobs × 5 connections = 50 total connections
# - Neon Pro limit: 100 connections (safe margin: 50 < 100)
#
# Neon example:
# DATABASE_URL="postgresql://username:password@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=5"
#
# Local PostgreSQL example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/vocatify?schema=public"
DATABASE_URL="postgresql://user:password@localhost:5432/vocatify?schema=public&connection_limit=5"

# Vercel Cron Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Required for API route authentication
CRON_SECRET=your-generated-secret-here

# Vercel URL (set automatically by Vercel, but needed for local testing)
VERCEL_URL=localhost:3000

# Authentication (NextAuth.js)
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_secret_here

# Google OAuth Credentials
# Get from: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID
# 2. Add authorized redirect URIs:
#    - Local: http://localhost:3000/api/auth/callback/google
#    - Production: https://your-domain.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=your_google_client_id_here
AUTH_GOOGLE_SECRET=your_google_client_secret_here
