# YouTube Data API v3
# Get your API key from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-api-key-here

# PostgreSQL Database
# For Vercel deployment, use Neon (recommended): https://console.neon.tech/signup
# Connection string format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
#
# Neon example:
# DATABASE_URL="postgresql://username:password@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require&connection_limit=10"
#
# Local PostgreSQL example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/vocatify?schema=public"
DATABASE_URL="postgresql://user:password@localhost:5432/vocatify?schema=public"

# Vercel Cron Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Required for API route authentication
CRON_SECRET=your-generated-secret-here

# Vercel URL (set automatically by Vercel, but needed for local testing)
VERCEL_URL=localhost:3000
